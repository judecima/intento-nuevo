NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value in browser code.
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_ORGANIZATION_SLUG=demo-corte

# Local migration/import only. Do not expose in browser code.
SUPABASE_DB_URL=
SUPABASE_DB_POOLER_URL=

# Optional E2E users. Keep real credentials only in .env.local or CI secrets.
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_SELLER_EMAIL=
E2E_SELLER_PASSWORD=
E2E_OPERATOR_EMAIL=
E2E_OPERATOR_PASSWORD=

# Optimizer staged V10 experimental path. Disabled by default.
# Master switch: when enabled, routes strategy=v10 through the staged V17/V20 pipeline.
OPTIMIZER_V10_STAGED_EXPERIMENTAL=0
# V20 isolated experiment: after baseline, run the cheap LB (no Raster). If it
# equals the physical incumbent, return before compactation/MultiSlice/Master.
OPTIMIZER_POST_BASELINE_CHEAP_LB_EXPERIMENTAL=0
# V21a (closed early): certified prepass before Master. Kept only for audit;
# it can save Master in at most one case of the frozen hotspot and is NOT the
# acceptance candidate.
OPTIMIZER_V21_FAMILY_PATTERNS_EXPERIMENTAL=0
# V21b acceptance candidate: replace the 40-round random Master pool with
# deterministic family-base/family-height seeds + 20 random rounds. Same solver,
# materializer and validator. Disabled by default until the 213/8669 gates pass.
OPTIMIZER_V21_FAMILY_MASTER_EXPERIMENTAL=0
# Other subfeatures default to enabled only when the master staged flag is on.
OPTIMIZER_STRONG_LOWER_BOUND_EXPERIMENTAL=1
OPTIMIZER_PRE_MULTISLICE_LB_EXPERIMENTAL=1
OPTIMIZER_INTEGRALITY_REPAIR_EXPERIMENTAL=1
OPTIMIZER_INCREMENTAL_MASTER_EXPERIMENTAL=1
OPTIMIZER_ADAPTIVE_RASTER_EXPERIMENTAL=1
OPTIMIZER_RASTER_MAX_PIECES=40
OPTIMIZER_RASTER_MAX_TYPES=16
OPTIMIZER_REPAIR_MAX_TYPES=16
