NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value in browser code.
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_ORGANIZATION_SLUG=demo-corte

# Optimizer worker. The app exposes POST /api/internal/optimizer-worker and a
# separate process can consume the queue with `npm run optimizer:worker`.
OPTIMIZER_WORKER_SECRET=
OPTIMIZER_WORKER_URL=http://localhost:3000/api/internal/optimizer-worker
OPTIMIZER_WORKER_IDLE_MS=1000
OPTIMIZER_WORKER_ERROR_MS=5000
# Set to 1 only for cron/one-shot invocations.
OPTIMIZER_WORKER_ONCE=0

# Candidate Rust Pattern Master generator. OFF by default.
# Only queued worker executions use it; inline/preview remains on JS.
# Requires the native addon to be built for the production OS/architecture.
OPTIMIZER_RUST_LEGACY_WORKER=0
# CI/diagnostic only: when 1, a Rust generation error is surfaced instead of
# falling back transparently to the legacy JS generator.
OPTIMIZER_RUST_LEGACY_STRICT=0
# Experimental warm continuation: when deterministic Beam work budgets are
# active, Deep60 may reuse the exact first 40 Rust Master rounds from a recent
# Balanced40 execution in the same worker process. Cache miss always runs cold.
OPTIMIZER_RUST_MASTER_ROUND_REUSE_EXPERIMENTAL=0

# Local migration/import only. Do not expose in browser code.
SUPABASE_DB_URL=
SUPABASE_DB_POOLER_URL=

# Optional E2E users. Keep real credentials only in .env.local or CI secrets.
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_SELLER_EMAIL=
E2E_SELLER_PASSWORD=
E2E_OPERATOR_EMAIL=
E2E_OPERATOR_PASSWORD=

# Optimizer staged V10 experimental path. Disabled by default.
# Master switch: when enabled, routes strategy=v10 through the staged V17/V20 pipeline.
OPTIMIZER_V10_STAGED_EXPERIMENTAL=0
# V20 isolated experiment: after baseline, run the cheap LB (no Raster). If it
# equals the physical incumbent, return before compactation/MultiSlice/Master.
# This flag works independently of OPTIMIZER_V10_STAGED_EXPERIMENTAL so the A/B
# can compare the legacy V10 path while changing exactly one variable.
OPTIMIZER_POST_BASELINE_CHEAP_LB_EXPERIMENTAL=0
# Other subfeatures default to enabled only when the master staged flag is on.
OPTIMIZER_STRONG_LOWER_BOUND_EXPERIMENTAL=1
OPTIMIZER_PRE_MULTISLICE_LB_EXPERIMENTAL=1
OPTIMIZER_INTEGRALITY_REPAIR_EXPERIMENTAL=1
OPTIMIZER_INCREMENTAL_MASTER_EXPERIMENTAL=1
OPTIMIZER_ADAPTIVE_RASTER_EXPERIMENTAL=1
OPTIMIZER_RASTER_MAX_PIECES=40
OPTIMIZER_RASTER_MAX_TYPES=16
OPTIMIZER_REPAIR_MAX_TYPES=16
